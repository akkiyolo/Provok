# Server .env for staging. Copy to .env.staging at the repo root (gitignored), fill in, then run:
#   infra/scripts/push-env.sh staging .env.staging
# Rules: comments only on their own lines (values are read literally, so "X=1  # note" would include the note),
# and letters/digits only in generated passwords (POSTGRES_PASSWORD is read by both Compose and the app).

# Compose + Caddy. SITE_DOMAIN = terraform output site_url without https://
SITE_DOMAIN=
ACME_EMAIL=
COMPOSE_PROFILES=localdb
# Search indexing: staging stays "noindex, nofollow" (the default); production sets ROBOTS_TAG=all.
POSTGRES_PASSWORD=

# App. Write the real domain in the URLs (nothing is interpolated).
APP_ENV=staging
WEB_URL=https://SITE_DOMAIN
API_URL=https://SITE_DOMAIN
CORS_ORIGINS=https://SITE_DOMAIN
COOKIE_SECURE=true
TRUSTED_PROXY_COUNT=1
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
DATABASE_URL=postgresql://provok:POSTGRES_PASSWORD@postgres:5432/provok
REDIS_URL=redis://redis:6379/0
# One process (API + background jobs); split out a worker container when traffic grows.
EMBEDDED_WORKER=true

# Storage + email. AWS credentials come from the server's IAM role, so no keys here.
STORAGE_BACKEND=s3
# terraform outputs media_bucket / media_base_url
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=
EMAIL_PROVIDER=ses
SES_REGION=ap-south-1
# Must be a verified SES identity. In the SES sandbox, recipients must be verified too.
EMAIL_FROM=Provok <you@example.com>

# Google sign-in: also add https://SITE_DOMAIN/api/v1/auth/google/callback to the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI + web research
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
DAILY_LLM_SPEND_ALERT_USD=5

# Optional
SENTRY_DSN_API=
