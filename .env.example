# ─────────────────────────────────────────────────────────────────────────────
# Provok — environment configuration. Copy to `.env` and fill in.
# Every value has a safe default for local development unless marked REQUIRED.
# In production (APP_ENV=production) the API refuses to boot with unsafe values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
WEB_URL=http://localhost:3000       # public site URL (emails, OAuth redirect, share links)
API_URL=http://localhost:8000       # public API URL (media URLs in local storage mode)
CORS_ORIGINS=http://localhost:3000  # comma-separated; never '*' in production
TRUSTED_PROXY_COUNT=0               # set to 1 behind Railway/Fly/Render/Cloudflare so client IPs are right
RELEASE=dev                         # git SHA in CI, shows up in Sentry

# ── Data ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://provok:provok@localhost:5432/provok   # REQUIRED in prod
DATABASE_PGBOUNCER=false            # true when using a transaction-mode pooler (Supabase/Neon pooler)
REDIS_URL=redis://localhost:6379/0  # REQUIRED in prod (Upstash works: rediss://...)

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-64-random-chars   # REQUIRED in prod:  python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
COOKIE_DOMAIN=                      # leave empty unless you share cookies across subdomains
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_VERIFIED_EMAIL_TO_DEBATE=true
GOOGLE_CLIENT_ID=                   # Google Cloud console → OAuth client (Web). Redirect URI:
GOOGLE_CLIENT_SECRET=               #   {WEB_URL}/api/v1/auth/google/callback

# ── Email (verification, password reset, async turn reminders) ──────────────
EMAIL_PROVIDER=console              # console | smtp | resend   (console is refused in production)
EMAIL_FROM=Provok <no-reply@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── LLM providers (any subset; models without a key seed as disabled) ───────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
UTILITY_MODEL_KEY=gemini_flash      # registry key for moderation/ledger/research/topic checks
UTILITY_FALLBACK_MODEL_KEYS=groq_gpt_oss_small,claude_haiku
JUDGE_MODEL_KEYS=judge_primary,judge_secondary,judge_groq
DEFAULT_SWARM_MODEL_KEY=gemini_flash
DAILY_LLM_SPEND_ALERT_USD=25        # above this, new AI debates are auto-paused + Sentry alert
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Research ─────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Monetisation ─────────────────────────────────────────────────────────────
FREE_AI_DEBATES=3
STANDARD_CREDIT_COST=1
FLAGSHIP_CREDIT_COST=4
FREE_DEBATES_COVER_FLAGSHIP=false
CREDIT_PACKS_JSON=[{"id":"starter","credits":5,"amount_inr":99,"label":"Starter"},{"id":"regular","credits":15,"amount_inr":249,"label":"Regular"},{"id":"pro","credits":40,"amount_inr":549,"label":"Pro"}]
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # Razorpay dashboard → Webhooks → {API_URL}/api/v1/payments/webhook
                                    # events: payment.captured, order.paid, payment.failed

# ── Video (LiveKit + Deepgram) ───────────────────────────────────────────────
LIVEKIT_URL=                        # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                 # LiveKit webhook → {API_URL}/api/v1/video/webhook
DEEPGRAM_API_KEY=
VIDEO_FREE_MINUTES_PER_MONTH=       # empty = unlimited
VIDEO_RECORDING_ENABLED=true        # needs STORAGE_BACKEND=s3

# ── Storage (avatars, recordings, clips) ─────────────────────────────────────
STORAGE_BACKEND=local               # local | s3   (use s3 in production)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=                    # for R2 / Supabase Storage / MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                 # CDN/public base URL for the bucket

# ── Safety ───────────────────────────────────────────────────────────────────
BLOCKED_TOPIC_CATEGORIES=politics,religion,caste
INJECTION_STRIKES_TO_RESTRICT=3
MODERATION_ENABLED=true

# ── Debate timing ────────────────────────────────────────────────────────────
LIVE_TURN_SECONDS=120
VIDEO_TURN_SECONDS=90
ASYNC_TURN_SECONDS=86400
DEFAULT_WORD_LIMIT=200
FEATURED_AVA_HOURS_UTC=4,13         # auto-create featured AI vs AI debates (10:00 & 19:00 IST)

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# ── Ops ──────────────────────────────────────────────────────────────────────
EMBEDDED_WORKER=false               # true runs the job worker inside the API process (single-dyno hosting)
ENABLE_DOCS=true                    # OpenAPI docs at /api/v1/docs (always off in production)
