# Provok web — copy to .env.local for `npm run dev`
API_INTERNAL_URL=http://localhost:8000        # where the Next server reaches FastAPI (also used for /api rewrites at build)
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # canonical public URL (OG tags, sitemap, share links)
NEXT_PUBLIC_WS_URL=ws://localhost:8000        # public websocket origin of the API (wss://api.yourdomain.com in prod)
NEXT_PUBLIC_LIVEKIT_URL=                      # wss://<project>.livekit.cloud (for the CSP)
NEXT_PUBLIC_MEDIA_ORIGIN=                     # CDN/bucket origin for recordings & clips (for the CSP)
NEXT_PUBLIC_SENTRY_DSN=                       # Sentry DSN for the web app (browser + Next server); empty = off
NEXT_PUBLIC_SENTRY_ENV=                       # e.g. production / staging (defaults to NODE_ENV)
# Business details shown on Terms / Privacy / Refunds / Contact (required by Razorpay)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
