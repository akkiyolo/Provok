{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "{$ROBOTS_TAG}"

	# The API and its websockets are served on the same origin, so the refresh cookie is first-party.
	@api path /api/* /ws/* /media/* /health /health/* /.well-known/assetlinks.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}

# Other names sent to the main site (REDIRECT_DOMAINS, comma-separated; e.g. provok.in while only staging is live).
# Temporary (302) so browsers don't remember it once that name gets its own site. When unset, compose passes a
# plain-HTTP placeholder name: no certificate is requested and nothing real is redirected.
{$REDIRECT_DOMAINS} {
	redir https://{$SITE_DOMAIN}{uri} 302
}
