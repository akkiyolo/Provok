# PROVOK — Environment Variables
# Copy to .env and fill in values

APP_NAME=PROVOK
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_PUBSUB_URL=redis://redis:6379/2

# Celery
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI / LLM
MISTRAL_API_KEY=
ZAI_API_KEY=
LLM_MODEL=mistral-medium-latest
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4000

# Embeddings
EMBEDDING_PROVIDER=Google
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Search
SEARCH_PROVIDER=TAVILY
SEARCH_API_KEY=

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=provok-dev

# Debate
DEFAULT_ROUNDS=4
LIVE_OPENING_TIMEOUT_SECONDS=180
LIVE_REBUTTAL_TIMEOUT_SECONDS=180
LIVE_CROSS_EXAM_TIMEOUT_SECONDS=90
LIVE_CLOSING_TIMEOUT_SECONDS=180
AUDIENCE_VOTING_DURATION_SECONDS=60

# Development
SEED_DATABASE=true
ENABLE_SWAGGER=true
